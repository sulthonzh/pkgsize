{
  "name": "pkgsize",
  "version": "1.0.0",
  "description": "Analyze what actually ships in your npm package — file sizes, tree composition, and trim suggestions",
  "main": "dist/index.js",
  "bin": {
    "pkgsize": "./dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "npm",
    "package",
    "size",
    "bundle",
    "publish",
    "analyze"
  ],
  "author": "sulthonzh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/pkgsize"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
